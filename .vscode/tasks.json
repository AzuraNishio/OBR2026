{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "main",
            "type": "shell",
            "command": "python -m pybricksdev run ble Spike/__init__.py",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build_oppening_book",
            "type": "shell",
            "command": "python Spike/V3/build_r3_opening_book.py --depth 5 --information-weight 40",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "stop",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$stopScript = @'\nimport sys\nimport asyncio\nfrom pybricksdev.connections import PybricksBLE\n\nasync def stop_program():\n    try:\n        hub = await PybricksBLE.find_device()\n        print(f\"Stopping program on {hub.device_info.name}...\")\n        await hub.stop()\n        print(\"Program stopped.\")\n    except Exception as e:\n        print(f\"Could not stop program: {e}\")\n        print(\"Try pressing the hub's button to stop the program.\")\n\nasyncio.run(stop_program())\n'@; $stopScript | & .venv\\Scripts\\python.exe -"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": false
            }
        }
    ]
}